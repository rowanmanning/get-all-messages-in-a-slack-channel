{
  "name": "@rowanmanning/get-all-messages-in-a-slack-channel",
  "version": "6.1.0",
  "description": "Get all messages in a public Slack channel",
  "keywords": [
    "slack"
  ],
  "author": "Rowan Manning (https://rowanmanning.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/rowanmanning/get-all-messages-in-a-slack-channel.git"
  },
  "homepage": "https://github.com/rowanmanning/get-all-messages-in-a-slack-channel",
  "bugs": "https://github.com/rowanmanning/get-all-messages-in-a-slack-channel/issues",
  "license": "MIT",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "verify": "npm run verify:biome && npm run verify:types",
    "verify:biome": "biome check",
    "verify:types": "tsc --project ./jsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "node --test --experimental-test-module-mocks --experimental-test-coverage --test-coverage-exclude test/unit/**/*.test.js --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-lines=100 test/unit/**/*.test.js",
    "prepare": "husky || true"
  },
  "peerDependencies": {
    "@slack/web-api": "^6.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@rowanmanning/biome-config": "^3.0.1",
    "husky": "^9.0.7",
    "typescript": "^5.5.2"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  }
}
